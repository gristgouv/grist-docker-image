diff --git a/app/server/lib/redisClient.ts b/app/server/lib/redisClient.ts
new file mode 100644
index 00000000000..074a73aedde
--- /dev/null
+++ b/app/server/lib/redisClient.ts
@@ -0,0 +1,7 @@
+import { createClient, RedisClient } from "redis";
+
+export function createRedisClient(url: string, onError: (err: Error) => void): RedisClient {
+  const client = createClient(url);
+  client.on("error", onError);
+  return client;
+}
diff --git a/test/server/lib/redisClient.ts b/test/server/lib/redisClient.ts
new file mode 100644
index 00000000000..68f70f3b506
--- /dev/null
+++ b/test/server/lib/redisClient.ts
@@ -0,0 +1,21 @@
+import { createRedisClient } from "app/server/lib/redisClient";
+
+import { assert } from "chai";
+import sinon from "sinon";
+
+describe("redisClient", function() {
+  describe("createRedisClient", function() {
+    it("reports a connection error rather than throwing it", function() {
+      const onError = sinon.spy();
+      const client = createRedisClient("redis://127.0.0.1:1/0", onError) as any;
+      try {
+        const err = new Error("getaddrinfo EAI_AGAIN redis-grist");
+        assert.doesNotThrow(() => client.emit("error", err));
+        assert.equal(client.listenerCount("error"), 1);
+        assert.deepEqual(onError.args, [[err]]);
+      } finally {
+        client.end(true);
+      }
+    });
+  });
+});

From a32761f1d8068ffceb2df8c9888cdae38f90b0d6 Mon Sep 17 00:00:00 2001
From: Ryan Lahfa <ryan.lahfa.ext@numerique.gouv.fr>
