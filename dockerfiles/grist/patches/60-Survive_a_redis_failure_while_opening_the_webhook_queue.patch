diff --git a/app/server/lib/WebhookQueue.ts b/app/server/lib/WebhookQueue.ts
index 507edc730d3..62ddfe6acc7 100644
--- a/app/server/lib/WebhookQueue.ts
+++ b/app/server/lib/WebhookQueue.ts
@@ -17,6 +17,7 @@ import { decodeObject } from "app/plugin/objtypes";
 import { ActiveDoc } from "app/server/lib/ActiveDoc";
 import log from "app/server/lib/log";
