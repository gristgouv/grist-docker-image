From cf115fcfb8cdd87f117c55e6ca4a5f6f9a160f5b Mon Sep 17 00:00:00 2001
From: Ryan Lahfa <ryan.lahfa.ext@numerique.gouv.fr>
Date: Wed, 18 Nov 2026 13:41:38 +0100
Subject: [PATCH 1/3] Add a home DB round-trip counter for tests

---
 app/gen-server/lib/TypeORMPatches.ts | 32 ++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/app/gen-server/lib/TypeORMPatches.ts b/app/gen-server/lib/TypeORMPatches.ts
index 5c959941607..7808b9e9075 100644
--- a/app/gen-server/lib/TypeORMPatches.ts
+++ b/app/gen-server/lib/TypeORMPatches.ts
@@ -317,6 +317,30 @@ export function testGetPreparedStatementCount() {
   };
 }
 
+/**
+ * Number of statements sent to a database while counting is enabled, and whether it
+ * is enabled. Counts across all drivers and connections.
+ */
+let queryCount = 0;
+let queryCounting = false;
+
+/**
+ * Start counting statements, resetting any previous count. Returns a function that stops
+ * counting and reports what was counted.
+ */
+export function testStartQueryCounting(): () => { count: number } {
+  queryCount = 0;
+  queryCounting = true;
+  return () => {
+    queryCounting = false;
+    return { count: queryCount };
+  };
+}
+
+function countQuery() {
+  if (queryCounting) { queryCount++; }
+}
+
 /**
  * Reset bookwork for tracking prepared statements.
  */
@@ -368,3 +392,11 @@ export class PostgresDriverPatched extends PostgresDriver {
 }
 
 PostgresDriver.prototype.createQueryRunner = PostgresDriverPatched.prototype.createQueryRunner;
+
+for (const proto of [PostgresQueryRunner.prototype, SqliteQueryRunner.prototype]) {
+  const originalQuery: (...args: any[]) => Promise<any> = (proto as any).query;
+  (proto as any).query = function(this: any, ...args: any[]) {
+    countQuery();
+    return originalQuery.apply(this, args);
+  };
+}

From dbd72ddc9c131f5c7671f18d81470553ee424b09 Mon Sep 17 00:00:00 2001
From: Ryan Lahfa <ryan.lahfa.ext@numerique.gouv.fr>
Date: Wed, 18 Nov 2026 13:42:44 +0100
Subject: [PATCH 2/3] Pin the round-trip count for reading a user

---
 test/gen-server/lib/roundTrips.ts | 46 +++++++++++++++++++++++++++++++
 1 file changed, 46 insertions(+)
 create mode 100644 test/gen-server/lib/roundTrips.ts

diff --git a/test/gen-server/lib/roundTrips.ts b/test/gen-server/lib/roundTrips.ts
new file mode 100644
index 00000000000..93f959d05bc
--- /dev/null
+++ b/test/gen-server/lib/roundTrips.ts
@@ -0,0 +1,46 @@
+import { HomeDBManager } from "app/gen-server/lib/homedb/HomeDBManager";
+import { testStartQueryCounting } from "app/gen-server/lib/TypeORMPatches";
+import { TestServer } from "test/gen-server/apiUtils";
+import * as testUtils from "test/server/testUtils";
+
+import { assert } from "chai";
+
+describe("roundTrips", function() {
+  let server: TestServer;
+  let home: HomeDBManager;
+  testUtils.setTmpLogLevel("error");
+
+  before(async function() {
+    server = new TestServer(this);
+    await server.start();
+    home = server.dbManager;
+  });
+
+  after(async function() {
+    await server.stop();
+  });
+
+  it("counts statements", async function() {
+    const stop = testStartQueryCounting();
+    await home.connection.query("SELECT 1");
+    assert.equal(stop().count, 1);
+  });
+
+  it("does not count while stopped", async function() {
+    const stop = testStartQueryCounting();
+    stop();
+    await home.connection.query("SELECT 1");
+    assert.equal(stop().count, 0);
+  });
+
+  it("reads a known user in one statement", async function() {
+    await home.getUserByLogin("kiwi@getgrist.com");
+
+    const stop = testStartQueryCounting();
+    const user = await home.getUserByLogin("kiwi@getgrist.com");
+    const { count } = stop();
+
+    assert.equal(user.name, "Kiwi");
+    assert.equal(count, 3);
+  });
+});

